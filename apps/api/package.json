{
  "name": "@sim/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist --splitting",
    "dev": "SIM_RUNTIME_SERVICE=api node --import ../../scripts/runtime/assert-node-22.mjs --import tsx --watch src/index.ts",
    "start": "node --import ../../scripts/runtime/assert-node-22.mjs dist/index.js",
    "test": "vitest run",
    "test:postgres": "SIM_REQUIRE_POSTGRES_TEST=1 vitest run tests/w2/native-tenant-read.postgres.test.ts",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@sim/api-contracts": "workspace:*",
    "@sim/audit": "workspace:*",
    "@sim/auth": "workspace:*",
    "@sim/biz-identity": "workspace:*",
    "@sim/db": "workspace:*",
    "@sim/execution-contracts": "workspace:*",
    "@sim/infra-appconfig": "workspace:*",
    "@sim/logger": "workspace:*",
    "@sim/platform-authz": "workspace:*",
    "@sim/security": "workspace:*",
    "@sim/utils": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "posthog-node": "5.28.9"
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "@types/node": "24.2.1",
    "tsx": "4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
