{
  "name": "@sim/auth",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.2.13",
    "node": ">=20.0.0"
  },
  "exports": {
    "./authorization": {
      "types": "./src/authorization.ts",
      "default": "./src/authorization.ts"
    },
    "./internal-token": {
      "types": "./src/internal-token.ts",
      "default": "./src/internal-token.ts"
    },
    "./request-context": {
      "types": "./src/request-context.ts",
      "default": "./src/request-context.ts"
    },
    "./session": {
      "types": "./src/session.ts",
      "default": "./src/session.ts"
    },
    "./verify": {
      "types": "./src/verify.ts",
      "default": "./src/verify.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@sim/api-contracts": "workspace:*",
    "@sim/db": "workspace:*",
    "better-auth": "1.6.23",
    "jose": "6.0.11"
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "@types/node": "24.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
